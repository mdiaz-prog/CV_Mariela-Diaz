<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hoja de Vida Académica - M.Sc. Mariela Alexi Díaz Ponce</title>
  <style>
    :root {
      --color-ink: #1e2532;
      --color-carbon: #0f141e;
      --color-pencil: #656e83;
      --color-fog: #828ba2;
      --color-paper: #ffffff;
      --color-mist: #f7f9fc;
      --color-lavender-wash: #f1f2ff;
      --color-chalk: #d9deeb;
      --color-ash: #e7eaf4;
      --color-signal-blue: #1a91f0;
      --color-deep-signal: #016fd0;
      --color-iris: #5660e8;
      --color-mint-whisper: #e7f4ed;
      --color-blush-whisper: #ffebe4;

      --font-main: 'TT Commons', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --radius-cards: 16px;
      --radius-buttons: 36px;
      --radius-tags: 100px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--color-mist);
      color: var(--color-ink);
      font-family: var(--font-main);
      line-height: 1.35;
      padding: 40px 20px;
      -webkit-font-smoothing: antialiased;
    }

    .cv-container {
      max-width: 1000px;
      margin: 0 auto;
      background: var(--color-paper);
      border: 1px solid var(--color-chalk);
      border-radius: var(--radius-cards);
      padding: 48px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }

    /* HEADER SECTION */
    .header {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 24px;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--color-chalk);
      margin-bottom: 32px;
    }

    .header-title h1 {
      font-size: 36px;
      font-weight: 600;
      color: var(--color-carbon);
      letter-spacing: -0.5px;
      line-height: 1.05;
      margin-bottom: 6px;
    }

    .header-title .subtitle {
      font-size: 18px;
      font-weight: 500;
      color: var(--color-signal-blue);
      margin-bottom: 12px;
    }

    .header-title .institution {
      font-size: 15px;
      color: var(--color-pencil);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .contact-badge-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: flex-end;
    }

    .contact-item {
      font-size: 14px;
      color: var(--color-pencil);
      background: var(--color-mist);
      padding: 6px 14px;
      border-radius: var(--radius-tags);
      border: 1px solid var(--color-ash);
      text-decoration: none;
    }

    /* METRICS / STAT COUNTERS */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 36px;
    }

    .stat-card {
      background: var(--color-mist);
      border: 1px solid var(--color-chalk);
      border-radius: 12px;
      padding: 18px 16px;
      text-align: center;
    }

    .stat-number {
      font-size: 28px;
      font-weight: 600;
      color: var(--color-signal-blue);
      line-height: 1;
      margin-bottom: 4px;
    }

    .stat-label {
      font-size: 13px;
      color: var(--color-pencil);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* LAYOUT GRID */
    .main-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 36px;
    }

    /* SIDEBAR */
    .sidebar-section {
      margin-bottom: 28px;
    }

    .section-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: var(--color-fog);
      margin-bottom: 12px;
    }

    .profile-card {
      background: var(--color-lavender-wash);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 24px;
    }

    .profile-card p {
      font-size: 14px;
      color: var(--color-ink);
      line-height: 1.45;
    }

    .tag-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .tag {
      font-size: 12px;
      font-weight: 500;
      background: var(--color-mist);
      color: var(--color-ink);
      border: 1px solid var(--color-chalk);
      padding: 4px 10px;
      border-radius: var(--radius-tags);
    }

    .degree-item {
      margin-bottom: 14px;
      padding-bottom: 12px;
      border-bottom: 1px stroke var(--color-ash);
    }

    .degree-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--color-carbon);
    }

    .degree-sub {
      font-size: 13px;
      color: var(--color-pencil);
    }

    /* MAIN CONTENT AREA */
    .content-section {
      margin-bottom: 32px;
    }

    .section-title {
      font-size: 20px;
      font-weight: 600;
      color: var(--color-carbon);
      border-bottom: 2px solid var(--color-signal-blue);
      padding-bottom: 6px;
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .timeline-item {
      padding-left: 16px;
      border-left: 2px solid var(--color-chalk);
      margin-bottom: 20px;
      position: relative;
    }

    .timeline-item::before {
      content: '';
      position: absolute;
      left: -6px;
      top: 4px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--color-signal-blue);
    }

    .item-role {
      font-size: 16px;
      font-weight: 600;
      color: var(--color-carbon);
    }

    .item-institution {
      font-size: 14px;
      color: var(--color-pencil);
      margin-bottom: 4px;
    }

    .item-date {
      font-size: 12px;
      color: var(--color-fog);
      font-weight: 500;
    }

    /* PUBLICATION CARDS */
    .pub-card {
      background: var(--color-paper);
      border: 1px solid var(--color-chalk);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      transition: all 0.2s ease;
    }

    .pub-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--color-carbon);
      margin-bottom: 6px;
      line-height: 1.3;
    }

    .pub-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      color: var(--color-pencil);
    }

    .journal-badge {
      background: var(--color-mint-whisper);
      color: #0d6832;
      font-weight: 600;
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 4px;
    }

    .book-badge {
      background: var(--color-blush-whisper);
      color: #902d13;
      font-weight: 600;
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 4px;
    }

    /* PRINT OPTIMIZATION */
    @media print {
      body { background: white; padding: 0; }
      .cv-container { border: none; box-shadow: none; padding: 0; max-width: 100%; }
      .stats-row { gap: 8px; }
      .pub-card { break-inside: avoid; }
    }
  </style>
</head>
